<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime denies camera/mic outright without these - the
	     all-in-one meeting client captures both inside Greenroom's own
	     process (the OBS Virtual Camera counts as a camera). Discovered
	     the hard way: black video, no prompt, no error. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
